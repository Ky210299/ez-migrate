{
    "name": "@ky210299/ez-migrate",
    "version": "0.5.0",
    "description": "Lightweight CLI for SQL migrations and seeds written in plain .sql files (MySQL, PostgreSQL, SQLite)",
    "main": "dist/ez-migrate.js",
    "bin": {
        "ez-migrate": "dist/ez-migrate.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec tsc",
        "test": "pnpm run build && vitest run",
        "test:watch": "vitest",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down",
        "lint": "eslint src/"
    },
    "keywords": [
        "migrations",
        "SQL",
        "databases"
    ],
    "author": "Leonardo Bazán Márquez",
    "license": "ISC",
    "packageManager": "pnpm@10.7.1",
    "dependencies": {
        "commander": "13.1.0",
        "mysql2": "^3.14.0",
        "pg": "^8.16.0",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.24.0",
        "@types/commander": "2.12.5",
        "@types/node": "^22.14.0",
        "@types/pg": "^8.15.2",
        "eslint": "^9.24.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.29.0",
        "vitest": "^3"
    },
    "engines": {
        "node": ">=22.13"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ky210299/ez-migrate.git"
    }
}
